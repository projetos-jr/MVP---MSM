# =============================================================================
# Assistente MSM — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores:
#   cp .env.example .env.local
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.
# =============================================================================

# --- Acesso -------------------------------------------------------------------
# Senha única para entrar no assistente (compartilhe com os colaboradores).
# Obrigatória em produção. Em desenvolvimento, se ficar vazia, entra sem senha.
APP_PASSWORD=troque-esta-senha

# (Opcional) Segredo para assinar o cookie de sessão. Se vazio, deriva da
# APP_PASSWORD (trocar a senha desconecta todo mundo).
SESSION_SECRET=

# --- IA: Google Gemini (gratuito, via Google AI Studio) -----------------------
# Crie a chave em https://aistudio.google.com/apikey (não precisa de cartão).
# Sem a chave, o chat funciona em "modo de teste sem IA" (mostra trechos).
GEMINI_API_KEY=

# Modelo principal (Flash mais recente do plano gratuito).
GEMINI_MODEL=gemini-3.8-flash

# Modelo reserva, usado se o principal atingir o limite (HTTP 429) ou estiver
# indisponível. Tem cota gratuita separada. Use "none" para desativar.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Nível de raciocínio dos modelos Gemini 3+ (low, medium, high; o 3.8 Flash
# não aceita "minimal"). "low" deixa as respostas mais rápidas.
GEMINI_THINKING_LEVEL=low

# Prazo (segundos) para o modelo começar a responder. Se estourar, o app tenta
# o modelo reserva; se ele também demorar, mostra uma mensagem de erro clara.
GEMINI_FIRST_TOKEN_SECONDS=15

# --- Base de conhecimento: Google Drive ---------------------------------------
# ID (ou link) da pasta do Drive com os documentos. Ex.: o trecho depois de
# /folders/ em https://drive.google.com/drive/folders/1AbC...xyz
# SE FICAR VAZIO, o app lê os arquivos da pasta seed-docs/ (modo de teste).
DRIVE_FOLDER_ID=

# Conta de serviço do Google Cloud (a pasta deve ser compartilhada com este
# e-mail como "Leitor").
GOOGLE_SERVICE_ACCOUNT_EMAIL=assistente-msm@seu-projeto.iam.gserviceaccount.com

# Chave privada da conta de serviço (campo "private_key" do JSON baixado).
# Cole entre aspas, em uma linha, com os \n literais — exatamente como no JSON:
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCOLE_AQUI\n-----END PRIVATE KEY-----\n"

# --- Ajustes finos (opcionais) ------------------------------------------------
# Máximo de caracteres de documentos enviados ao modelo por pergunta. Acima
# disso, o app pré-seleciona os trechos mais relevantes (busca BM25).
MAX_CONTEXT_CHARS=150000

# Intervalo mínimo (segundos) entre verificações da pasta do Drive.
DRIVE_REFRESH_SECONDS=120
